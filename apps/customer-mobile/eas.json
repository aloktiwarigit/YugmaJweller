{
  "_comment": "EAS build configuration. See docs/runbook.md §20 for first-build steps and value-population guide. Tenant production values live in the EAS production environment or local .env.production, not in committed eas.json. Development + preview profiles point to the anchor-dev Cloud Run API for the demo flow.",
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_DEV_AUTH": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://goldsmith-api-528920018833.asia-south1.run.app",
        "EXPO_PUBLIC_SHOP_SLUG": "anchor-dev",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.goldsmith.customer.dev",
        "EXPO_PUBLIC_IOS_BUNDLE_ID": "com.goldsmith.customer.dev",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "goldsmith-dev",
        "EXPO_PUBLIC_APP_NAME": "श्री राम ज्वैलर्स"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://goldsmith-api-528920018833.asia-south1.run.app",
        "EXPO_PUBLIC_SHOP_SLUG": "anchor-dev",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.goldsmith.customer.dev",
        "EXPO_PUBLIC_IOS_BUNDLE_ID": "com.goldsmith.customer.dev",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "goldsmith-dev",
        "EXPO_PUBLIC_APP_NAME": "श्री राम ज्वैलर्स"
      }
    },
    "production": {
      "_comment": "Android Play internal/production profile. WHITE-LABEL NOTE: Every tenant gets a SEPARATE production build with their own package name, app name, and Firebase project. Do NOT share one production AAB across tenants. See docs/runbook.md §20.",
      "distribution": "store",
      "channel": "production",
      "credentialsSource": "remote",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "BUILD_TARGET_PLATFORM": "android",
        "EXPO_PUBLIC_DEV_AUTH": "0"
      }
    },
    "production-ios": {
      "_comment": "Deferred iOS store profile. Populate only when App Store release work starts.",
      "distribution": "store",
      "channel": "production",
      "credentialsSource": "remote",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "BUILD_TARGET_PLATFORM": "ios",
        "EXPO_PUBLIC_DEV_AUTH": "0"
      }
    }
  },
  "submit": {
    "production": {
      "_comment": "Populate after Play Store / App Store developer accounts are created. See docs/runbook.md §20.",
      "android": {
        "serviceAccountKeyPath": "REPLACE_WITH_PATH_TO_PLAY_STORE_SERVICE_ACCOUNT_JSON",
        "track": "internal"
      },
      "ios": {
        "_comment": "iOS submission deferred. Apple Developer Program enrollment required per tenant. See docs/runbook.md §20.",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    },
    "production-ios": {
      "ios": {
        "_comment": "iOS submission deferred. Apple Developer Program enrollment required per tenant. See docs/runbook.md §20.",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}

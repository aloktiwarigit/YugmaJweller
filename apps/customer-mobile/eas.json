{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "BUILD_TARGET_PLATFORM": "android"
      }
    },
    "production-ios": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "production",
        "BUILD_TARGET_PLATFORM": "ios"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

APP_ENV=production
BUILD_TARGET_PLATFORM=android

# Runtime app identity.
EXPO_PUBLIC_APP_NAME=Ayodhya Swarnkar Manager
EXPO_PUBLIC_APP_VERSION=1.0.0
ANDROID_VERSION_CODE=1

# Current release target mirrors customer-mobile local production setup.
EXPO_PUBLIC_API_BASE_URL=https://goldsmith-api-528920018833.asia-south1.run.app
EXPO_PUBLIC_TENANT_SLUG=anchor-dev
EXPO_PUBLIC_ANDROID_PACKAGE=com.goldsmith.shopkeeper
EXPO_PUBLIC_FIREBASE_PROJECT_ID=goldsmith-dev
GOOGLE_SERVICES_JSON=./android/app/google-services.json

# Signing uses the same Azure Key Vault-backed upload key as customer-mobile
# unless these secret names are overridden.
AZURE_KEYVAULT_NAME=kv-writ-prod
ANDROID_KEYSTORE_B64_SECRET=goldsmith-customer-keystore-b64
ANDROID_STORE_PASSWORD_SECRET=goldsmith-customer-store-password
ANDROID_KEY_ALIAS_SECRET=goldsmith-customer-key-alias
ANDROID_KEY_PASSWORD_SECRET=goldsmith-customer-key-password
